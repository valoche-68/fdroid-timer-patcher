+package org.fdroid.ui.settings
+
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+import org.junit.Test
+
+class DurationPreferenceTest {
+
+  @Test
+  fun testFormatDuration() {
+    assertEquals("15 min", formatDuration(15))
+    assertEquals("59 min", formatDuration(59))
+    assertEquals("1 h", formatDuration(60))
+    assertEquals("1 h 05", formatDuration(65))
+    assertEquals("2 h 30", formatDuration(150))
+    assertEquals("4 h", formatDuration(240))
+    assertEquals("24 h", formatDuration(1440))
+    assertEquals("999 h 59", formatDuration(999 * 60 + 59))
+  }
+
+  @Test
+  fun testParseValidDuration() {
+    assertEquals(15, parseDuration("0", "15"))
+    assertEquals(15, parseDuration("", "15"))
+    assertEquals(60, parseDuration("1", ""))
+    assertEquals(60, parseDuration("1", "0"))
+    assertEquals(150, parseDuration("2", "30"))
+    assertEquals(150, parseDuration("02", "30"))
+    assertEquals(999 * 60 + 59, parseDuration("999", "59"))
+  }
+
+  @Test
+  fun testParseInvalidDuration() {
+    // below minimum
+    assertNull(parseDuration("0", "0"))
+    assertNull(parseDuration("", ""))
+    assertNull(parseDuration("0", "14"))
+    assertNull(parseDuration("0", "10"))
+    // out of range
+    assertNull(parseDuration("1", "60"))
+    assertNull(parseDuration("1000", "0"))
+    assertNull(parseDuration("-1", "30"))
+    assertNull(parseDuration("1", "-5"))
+    // not a number
+    assertNull(parseDuration("a", "30"))
+    assertNull(parseDuration("1", "3x"))
+  }
+}
