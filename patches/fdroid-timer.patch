diff --git a/app/src/main/kotlin/org/fdroid/utils/PeriodicWorkInterval.kt b/app/src/main/kotlin/org/fdroid/utils/PeriodicWorkInterval.kt
new file mode 100644
index 0000000..ce305e3
--- /dev/null
+++ b/app/src/main/kotlin/org/fdroid/utils/PeriodicWorkInterval.kt
@@ -0,0 +1,25 @@
+package org.fdroid.utils
+
+import androidx.work.PeriodicWorkRequest.Companion.MIN_PERIODIC_FLEX_MILLIS
+import androidx.work.PeriodicWorkRequest.Companion.MIN_PERIODIC_INTERVAL_MILLIS
+import java.util.concurrent.TimeUnit.MINUTES
+
+/** Repeat interval and flex interval (both in milliseconds) of a periodic work request. */
+data class PeriodicWorkInterval(val intervalMillis: Long, val flexMillis: Long)
+
+/**
+ * Computes a valid [PeriodicWorkInterval] for the given user-chosen [intervalMinutes].
+ *
+ * The interval is clamped to at least [MIN_PERIODIC_INTERVAL_MILLIS] (15 minutes). The flex
+ * interval is [defaultFlexMinutes], but never longer than the interval itself and never shorter
+ * than [MIN_PERIODIC_FLEX_MILLIS].
+ */
+fun getPeriodicWorkInterval(intervalMinutes: Int, defaultFlexMinutes: Int): PeriodicWorkInterval {
+  val intervalMillis =
+    MINUTES.toMillis(intervalMinutes.toLong()).coerceAtLeast(MIN_PERIODIC_INTERVAL_MILLIS)
+  val flexMillis =
+    MINUTES.toMillis(defaultFlexMinutes.toLong())
+      .coerceAtMost(intervalMillis)
+      .coerceAtLeast(MIN_PERIODIC_FLEX_MILLIS)
+  return PeriodicWorkInterval(intervalMillis, flexMillis)
+}
