@@ -0,0 +1,61 @@
+package org.fdroid.utils
+
+import java.util.concurrent.TimeUnit.MINUTES
+import kotlin.test.assertEquals
+import org.junit.Test
+
+class PeriodicWorkIntervalTest {
+
+  @Test
+  fun testDefaultsAreUnchanged() {
+    // repo updates: 4h with 15 min flex
+    assertEquals(
+      PeriodicWorkInterval(MINUTES.toMillis(240), MINUTES.toMillis(15)),
+      getPeriodicWorkInterval(240, 15),
+    )
+    // app updates: 24h with 60 min flex
+    assertEquals(
+      PeriodicWorkInterval(MINUTES.toMillis(1440), MINUTES.toMillis(60)),
+      getPeriodicWorkInterval(1440, 60),
+    )
+  }
+
+  @Test
+  fun testIntervalIsClampedToMinimum() {
+    for (minutes in listOf(Int.MIN_VALUE, -1, 0, 1, 14, 15)) {
+      assertEquals(
+        PeriodicWorkInterval(MINUTES.toMillis(15), MINUTES.toMillis(15)),
+        getPeriodicWorkInterval(minutes, 15),
+      )
+    }
+  }
+
+  @Test
+  fun testFlexIsNotLongerThanInterval() {
+    assertEquals(
+      PeriodicWorkInterval(MINUTES.toMillis(30), MINUTES.toMillis(30)),
+      getPeriodicWorkInterval(30, 60),
+    )
+    assertEquals(
+      PeriodicWorkInterval(MINUTES.toMillis(15), MINUTES.toMillis(15)),
+      getPeriodicWorkInterval(10, 60),
+    )
+  }
+
+  @Test
+  fun testFlexIsNotShorterThanMinimum() {
+    assertEquals(
+      PeriodicWorkInterval(MINUTES.toMillis(60), MINUTES.toMillis(5)),
+      getPeriodicWorkInterval(60, 0),
+    )
+  }
+
+  @Test
+  fun testLargeInterval() {
+    val minutes = 999 * 60 + 59
+    assertEquals(
+      PeriodicWorkInterval(MINUTES.toMillis(minutes.toLong()), MINUTES.toMillis(60)),
+      getPeriodicWorkInterval(minutes, 60),
+    )
+  }
+}
